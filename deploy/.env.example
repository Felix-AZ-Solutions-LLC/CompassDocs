# CompassDocs self-hosting configuration (used by deploy/docker-compose.yml).
# The install script generates strong random values for you; if you write this
# by hand, replace the passwords with your own secrets.

# Database password (any strong random string).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Admin account. Leave these unset to create your admin in the browser via the
# first-run setup wizard (recommended). Set both to pre-create it headlessly.
# COMPASSDOCS_ADMIN_USER=admin
# COMPASSDOCS_ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: enable AI-powered "Ask CompassDocs" answers. Search works without it.
# ANTHROPIC_API_KEY=sk-ant-...

# Port to expose the app on (http://localhost:PORT). Used by docker-compose.yml.
PORT=3000

# Which address that port is published on (1.20.27). Leave unset when people
# reach CompassDocs on PORT directly. If your own reverse proxy on this host
# forwards to it, set 127.0.0.1 so nobody can bypass the proxy (and forge the
# X-Forwarded-For address the sign-in throttle reads).
# COMPASSDOCS_BIND=127.0.0.1

# Reverse proxies in front of the app, counted from the app (default 1: the
# bundled Caddy, or your own proxy). Set 2 when another proxy (Cloudflare, a
# load balancer) sits in front of that one.
# COMPASSDOCS_TRUSTED_PROXY_HOPS=1

# The workspace's address for links in mail (1.20.27), when no custom domain
# is set under Settings → Domain & HTTPS: e.g. https://docs.example.com, or an
# intranet address like http://intranet:3000. Links in desk and portal mail
# are built only from the custom domain or this, never from a request's Host;
# with neither, the customer portal sends no sign-in links.
# COMPASSDOCS_BASE_URL=

# Fallback addresses (1.20.29, HTTPS compose only): comma-separated DNS names
# the bundled proxy keeps serving after a custom domain is applied, each with
# its own certificate plus plain HTTP, so you can still get in if the domain
# breaks. The Azure template sets the VM's <label>.<region>.cloudapp.azure.com.
# Links in email always use the custom domain, never these.
# COMPASSDOCS_FALLBACK_HOSTS=

# Fixed first-run setup token (1.20.27). Leave unset: a token is derived from
# the secret key and printed in `docker compose logs app` until setup is done.
# COMPASSDOCS_SETUP_TOKEN=

# Emergency switch for "SSO only" (1.20.27). If single sign-on stops working
# and no break-glass account can sign in, set this to 1 and restart: every
# account with a password can sign in with it again, and every settings page
# says so until you remove it.
# COMPASSDOCS_SSO_ONLY_DISABLED=1

# Serving over plain HTTP (no HTTPS)? Set this to 1, or logins will loop —
# browsers won't send the Secure session cookie over http://. Use only for
# internal (LAN/VPN) setups; leave UNSET for anything internet-facing (put it
# behind HTTPS instead).
# COMPASSDOCS_INSECURE_COOKIES=1

# --- Custom domain & HTTPS (docker-compose.tls.yml) --------------------------
# Serve CompassDocs on your own domain with HTTPS via a bundled Caddy reverse
# proxy. Point the domain's DNS at this server and run:
#   docker compose -f docker-compose.tls.yml up -d
# Then set the domain and certificate mode in the web UI, under
# Settings → Domain & HTTPS — no env vars or config files to edit.

# --- Backups -----------------------------------------------------------------
# Full-database backups are always written to the local ./backups volume.
# Optionally mirror them off-site to S3 or Azure. The easiest way is the web UI
# (Settings → Backups → Off-site destinations), which stores the credentials and
# can test the connection. These env vars are an alternative for config-as-code;
# a destination configured in the UI takes precedence over them.
#
# S3-compatible (AWS S3, Cloudflare R2, MinIO, …):
# BACKUP_S3_BUCKET=my-compassdocs-backups
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY_ID=...
# BACKUP_S3_SECRET_ACCESS_KEY=...
# BACKUP_S3_ENDPOINT=            # set for R2/MinIO, e.g. https://<acct>.r2.cloudflarestorage.com
# BACKUP_S3_PREFIX=              # optional key prefix, e.g. compassdocs
#
# Azure Blob Storage:
# BACKUP_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...
# BACKUP_AZURE_CONTAINER=compassdocs-backups

# Optional: pin a specific released version instead of the latest image.
# COMPASSDOCS_VERSION=1.0.0
